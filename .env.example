# Copie este arquivo para ".env" e ajuste se quiser:
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
# O ".env" NÃO deve ser enviado para o Git nem para outras pessoas.
#
# Os valores abaixo são exemplos para uso LOCAL. Em qualquer outro ambiente, troque todos.

# Porta do seu computador onde a API vai aparecer (http://localhost:PORTA)
API_PORT=8000

# Chave que assina os tokens de login (JWT). Use 32+ caracteres aleatórios.
# Para gerar uma: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres

# Custo do hash de senha (maior = mais seguro e mais lento)
PBKDF2_ITERATIONS=600000

# Origens autorizadas a chamar a API pelo navegador, separadas por vírgula ("*" = qualquer uma)
CORS_ORIGINS=*

# Usuários criados na primeira vez que a API sobe (o banco ainda está vazio)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_SENHA=Admin@123
SEED_MEMBER_EMAIL=member@example.com
SEED_MEMBER_SENHA=Member@123

# DATABASE_URL não precisa ser definida aqui: o docker-compose.yml já aponta o banco SQLite
# para o volume "dados" (sqlite:////data/gerador_personagens.db).
